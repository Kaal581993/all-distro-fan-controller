   616	static time_t tick_time(void)
   617	{
   618	    struct timespec now;
   619	    if (clock_gettime(CLOCK_BOOTTIME, &now)) {
   620	        perror("Monotonic clock");
   621	        stopping = 1;
   622	        return 0;
   623	    }
   624	    return now.tv_sec;
   625	}
   626	
   627	static int daemon_main(bool stdio_test)
   628	{
   629	    if (!simulation[0] && !user_daemon && (geteuid() != 0 || owner == 0)) {
   630	        fprintf(stderr, "Install the system service; it needs root and a non-root --uid.\n");
   631	        return 1;
   632	    }
   633	    char lock_path[PATH_MAX];
   634	    format(lock_path, sizeof lock_path, "%s.lock", socket_path);
   635	    int lock = open(lock_path, O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
   636	    if (lock < 0 || flock(lock, LOCK_EX | LOCK_NB)) { perror("Daemon lock"); return 1; }
   637	    int fd = stdio_test ? STDIN_FILENO : socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
   638	    if (fd < 0) { perror("socket"); close(lock); return 1; }
   639	    struct sockaddr_un addr = {.sun_family = AF_UNIX};
   640	    if (strlen(socket_path) >= sizeof addr.sun_path) {
   641	        fprintf(stderr, "Socket path too long\n"); close(fd); close(lock); return 1;
   642	    }
   643	    strcpy(addr.sun_path, socket_path);
   644	    if (!stdio_test) {
   645	        unlink(socket_path);
   646	        mode_t old = umask(0077);
   647	        int rc = bind(fd, (struct sockaddr *)&addr, sizeof addr);
   648	        umask(old);
   649	        if (rc || chmod(socket_path, 0600) ||
   650	            (geteuid() == 0 && chown(socket_path, owner, (gid_t)-1)) || listen(fd, 8)) {
   651	            perror("Creating control socket"); close(fd); close(lock); return 1;
   652	        }
   653	    }
   654	    struct sigaction action = {.sa_handler = on_signal};
   655	    sigemptyset(&action.sa_mask);
   656	    sigaction(SIGINT, &action, NULL);
   657	    sigaction(SIGTERM, &action, NULL);
   658	    signal(SIGPIPE, SIG_IGN);
   659	    load_settings();
   660	    step();
   661	    fprintf(stderr, "Fan Control Center ready; authorized uid=%lu; %s\n",
   662	            (unsigned long)owner, simulation[0] ? "simulated hardware" : hw.model);
   663	    if (stdio_test) {
   664	        setvbuf(stdin, NULL, _IONBF, 0);
   665	        setvbuf(stdout, NULL, _IONBF, 0);
   666	        puts("READY");
   667	    }
   668	    time_t last_tick = tick_time();
   669	    char previous_error[512] = "";
   670	    while (!stopping) {
   671	        struct pollfd item = {.fd = fd, .events = POLLIN};
   672	        if (poll(&item, 1, 250) > 0) {
   673	            if (stdio_test && (item.revents & (POLLIN | POLLHUP))) {
   674	                char request[256];
   675	                if (!fgets(request, sizeof request, stdin)) break;
   676	                char *end = strchr(request, '\n');
   677	                if (!end) { puts("ERR Invalid request"); puts("END"); }
   678	                else {
   679	                    *end = '\0';
   680	                    respond(request, stdout);
   681	                    puts("END");
   682	                }
   683	            } else if (item.revents & POLLIN) {
   684	                int client = accept4(fd, NULL, NULL, SOCK_CLOEXEC);
   685	                if (client >= 0) handle_client(client);
   686	            }
   687	        }
   688	        if (tick_time() - last_tick >= 2) {
   689	            step();
   690	            last_tick = tick_time();
   691	        }
   692	        if (strcmp(previous_error, last_error)) {
   693	            fprintf(stderr, "%s%s\n", last_error[0] ? "Hardware error: " : "Hardware controls OK", last_error);
   694	            strcpy(previous_error, last_error);
   695	        }
   696	    }
   697	    last_error[0] = '\0';
   698	    restore();
   699	    if (last_error[0]) fprintf(stderr, "Restore error: %s\n", last_error);
   700	    if (!stdio_test) { close(fd); unlink(socket_path); }
   701	    close(lock);
   702	    return last_error[0] ? 1 : 0;
   703	}
