    80	    fclose(f);
    81	    if (!ok) return false;
    82	    size_t len = strlen(out);
    83	    while (len && isspace((unsigned char)out[len - 1])) out[--len] = '\0';
    84	    for (size_t i = 0; i < len; ++i)
    85	        if ((unsigned char)out[i] < 32) out[i] = ' ';
    86	    return true;
    87	}
