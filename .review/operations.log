    gtk_box_pack_start(GTK_BOX(footer), monitor_button, FALSE, FALSE, 0);
    gtk_box_pack_end(GTK_BOX(footer), release_button, FALSE, FALSE, 0);
    gtk_box_pack_end(GTK_BOX(box), footer, FALSE, FALSE, 0);
    gtk_widget_show_all(window);
