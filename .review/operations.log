   318	    }
   319	    if (hw.intel_write) {
   320	        /* Disable turbo before reducing the ceiling. Lower a conflicting
   321	           minimum first, so the requested ceiling can actually take effect. */
   322	        if (!boost) set_sys(PSTATE "no_turbo", 1);
   323	        if (hw.min_cap > cap) set_sys(PSTATE "min_perf_pct", cap);
   324	        set_sys(PSTATE "max_perf_pct", cap);
   325	        if (boost) set_sys(PSTATE "no_turbo", 0);
   326	        char pattern[PATH_MAX];
   327	        syspath(pattern, "/sys/devices/system/cpu/cpufreq/policy*");
   328	        glob_t policies = {0};
   329	        if (!glob(pattern, 0, NULL, &policies))
   330	            for (size_t i = 0; i < policies.gl_pathc; ++i) {
   331	                format(path, sizeof path, "%s/scaling_governor", policies.gl_pathv[i]);
   332	                if (access(path, W_OK) == 0) set_value(path, "powersave", true);
   333	                const char *epp = profile == PERFORMANCE && !hw.guard ? "balance_performance" :
   334	                                  profile == SAVING ? "power" : "balance_power";
   335	                format(path, sizeof path, "%s/energy_performance_available_preferences", policies.gl_pathv[i]);
   336	                char available[256];
   337	                if (!read_text(path, available, sizeof available) || !strstr(available, epp)) continue;
   338	                format(path, sizeof path, "%s/energy_performance_preference", policies.gl_pathv[i]);
   339	                if (access(path, W_OK) == 0) set_value(path, epp, true);
   340	            }
   341	        globfree(&policies);
   342	    }
   343	    for (int i = 0; i < 2; ++i) {
   344	        if (!hw.fan[i][0]) continue;
   345	        if (!hw.fan_write[i]) {
   346	            errno = EACCES;
   347	            error_at(hw.fan[i]);
   348	            continue;
   349	        }
   350	        /* ASUS reports a cached mode. Reissue full speed on every cycle even
   351	           when the cached value is already 0, so firmware resets are retried. */
   352	        if (full) write_text(hw.fan[i], "0");
