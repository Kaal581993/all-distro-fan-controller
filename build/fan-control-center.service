[Unit]
Description=Fan Control Center hardware and power profile service
After=systemd-udevd.service
ConditionPathExists=/sys/class/hwmon

[Service]
Type=simple
ExecStart=/home/kaal/fan-control-center/build/fanctl --uid 1000 --daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
RuntimeDirectory=fan-control-center
RuntimeDirectoryMode=0755
StateDirectory=fan-control-center
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ReadWritePaths=/sys/devices/platform /sys/devices/system/cpu /sys/firmware/acpi /run/fan-control-center /var/lib/fan-control-center
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
